Imports MySql.Data.MySqlClient

Public Class frmExpenses

    Dim isLoading As Boolean = False
    Dim selectedExpenseID As Integer = 0
    Dim pendingDeleteID As Integer = 0

    Private Sub frmExpenses_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        LoadCategories()
        LoadExpenses()
        ClearEditPanel()
        dgvExpenses.DefaultCellStyle.Font = New Font("Segoe UI", 9, FontStyle.Bold)
        dgvExpenses.ColumnHeadersDefaultCellStyle.Font = New Font("Segoe UI", 9, FontStyle.Bold)
    End Sub

    ' ── categories ────────────────────────────────────────────────────────
    Private Sub LoadCategories()
        Dim conn = DBConnection.GetConnection()
        conn.Open()
        Dim cmd As New MySqlCommand("SELECT CategoryID, CategoryName FROM ExpenseCategories ORDER BY CategoryName", conn)
        Dim adapter As New MySqlDataAdapter(cmd)
        Dim dt As New DataTable
        adapter.Fill(dt)
        conn.Close()

        ' Add/Update combo — actual categories only, no "All", and no "Restock"
        ' (Restock expenses are auto-generated from frmInventory, not created here)
        Dim dtAddUpdate = dt.Copy()
        Dim restockRows = dtAddUpdate.Select("CategoryName = 'Restock'")
        For Each r In restockRows
            dtAddUpdate.Rows.Remove(r)
        Next

        cboCategory.DisplayMember = "CategoryName"
        cboCategory.ValueMember = "CategoryID"
        cboCategory.DataSource = dtAddUpdate
        cboCategory.SelectedIndex = -1

        ' Filter combo — separate copy, includes "All Categories" and "Restock"
        Dim dtFilter = dt.Copy()
        Dim allRow = dtFilter.NewRow()
        allRow("CategoryID") = 0
        allRow("CategoryName") = "All Categories"
        dtFilter.Rows.InsertAt(allRow, 0)

        cboFilterCategory.DisplayMember = "CategoryName"
        cboFilterCategory.ValueMember = "CategoryID"
        cboFilterCategory.DataSource = dtFilter
        cboFilterCategory.SelectedIndex = 0
    End Sub

    ' ── load / display expenses ──────────────────────────────────────────
    Private Sub LoadExpenses(Optional categoryID As Integer = 0,
                         Optional dateFrom As DateTime = Nothing,
                         Optional dateTo As DateTime = Nothing,
                         Optional searchTerm As String = "")
        isLoading = True

        Dim query As String =
        "SELECT e.ExpenseID, ec.CategoryName, e.Description, e.Amount,
                e.ExpenseDate, e.IsAutoGenerated
         FROM Expenses e
         INNER JOIN ExpenseCategories ec ON e.CategoryID = ec.CategoryID
         WHERE 1=1"

        If categoryID > 0 Then query &= " AND e.CategoryID = @cat"
        If dateFrom <> Nothing Then query &= " AND e.ExpenseDate >= @from"
        If dateTo <> Nothing Then query &= " AND e.ExpenseDate <= @to"
        If Not String.IsNullOrWhiteSpace(searchTerm) Then query &= " AND e.Description LIKE @search"
        query &= " ORDER BY e.ExpenseDate DESC"

        Dim conn = DBConnection.GetConnection()
        conn.Open()
        Dim cmd As New MySqlCommand(query, conn)
        If categoryID > 0 Then cmd.Parameters.AddWithValue("@cat", categoryID)
        If dateFrom <> Nothing Then cmd.Parameters.AddWithValue("@from", dateFrom.ToString("yyyy-MM-dd"))
        If dateTo <> Nothing Then cmd.Parameters.AddWithValue("@to", dateTo.ToString("yyyy-MM-dd"))
        If Not String.IsNullOrWhiteSpace(searchTerm) Then cmd.Parameters.AddWithValue("@search", "%" & searchTerm.Trim() & "%")

        Dim adapter As New MySqlDataAdapter(cmd)
        Dim dt As New DataTable
        adapter.Fill(dt)
        conn.Close()

        dgvExpenses.DataSource = dt
        dgvExpenses.AllowUserToAddRows = False
        dgvExpenses.ReadOnly = True

        dgvExpenses.Columns("ExpenseID").Visible = False
        dgvExpenses.Columns("IsAutoGenerated").Visible = False
        dgvExpenses.Columns("CategoryName").DisplayIndex = 0
        dgvExpenses.Columns("Description").DisplayIndex = 1
        dgvExpenses.Columns("Amount").DisplayIndex = 2
        dgvExpenses.Columns("ExpenseDate").DisplayIndex = 3

        isLoading = False
        UpdateTotalLabel()
    End Sub
    Private Sub UpdateTotalLabel()
        Dim total As Decimal = 0
        For Each row As DataGridViewRow In dgvExpenses.Rows
            If row.Cells("Amount").Value IsNot Nothing Then
                total += Convert.ToDecimal(row.Cells("Amount").Value)
            End If
        Next
        lblTotalExpenses.Text = "Total Expenses: ₱" & total.ToString("0.00")
    End Sub

    ' ── select a row: load it into the edit panel ────────────────────────
    Private Sub dgvExpenses_CellClick(sender As Object, e As DataGridViewCellEventArgs) Handles dgvExpenses.CellClick
        If isLoading Then Return
        If e.RowIndex < 0 Then Return

        Dim row = dgvExpenses.Rows(e.RowIndex)
        selectedExpenseID = Convert.ToInt32(row.Cells("ExpenseID").Value)

        Dim isAuto = Convert.ToBoolean(row.Cells("IsAutoGenerated").Value)

        cboCategory.SelectedValue = GetCategoryIDByName(row.Cells("CategoryName").Value.ToString())
        txtDescription.Text = row.Cells("Description").Value.ToString()
        txtAmount.Text = row.Cells("Amount").Value.ToString()
        dtpExpenseDate.Value = Convert.ToDateTime(row.Cells("ExpenseDate").Value)

        ' Auto-generated expenses (e.g. from restocks) shouldn't be hand-edited here.
        cboCategory.Enabled = Not isAuto
        txtDescription.Enabled = Not isAuto
        txtAmount.Enabled = Not isAuto
        dtpExpenseDate.Enabled = Not isAuto
        btnUpdate.Enabled = Not isAuto
        btnDelete.Enabled = Not isAuto


    End Sub

    Private Function GetCategoryIDByName(name As String) As Integer
        Dim dt = CType(cboCategory.DataSource, DataTable)
        Dim rows = dt.Select("CategoryName = '" & name.Replace("'", "''") & "'")
        If rows.Length > 0 Then Return Convert.ToInt32(rows(0)("CategoryID"))
        Return 0
    End Function

    ' ── message helper (shows MessageBox for status/errors) ──────────────
    Private Sub ShowMessage(text As String, Optional isError As Boolean = False)
        If String.IsNullOrEmpty(text) Then Return
        MessageBox.Show(text)
    End Sub
    ' ── validation shared by Add/Update ──────────────────────────────────
    Private Function TryGetValidatedInput(ByRef categoryID As Integer, ByRef description As String,
                                           ByRef amount As Decimal, ByRef expenseDate As DateTime) As Boolean
        If cboCategory.SelectedValue Is Nothing OrElse Convert.ToInt32(cboCategory.SelectedValue) = 0 Then
            ShowMessage("Please select a category.", True)
            Return False
        End If
        categoryID = Convert.ToInt32(cboCategory.SelectedValue)

        description = txtDescription.Text.Trim()
        If String.IsNullOrWhiteSpace(description) Then
            ShowMessage("Please enter a description.", True)
            Return False
        End If

        If Not Decimal.TryParse(txtAmount.Text, amount) OrElse amount < 0 Then
            ShowMessage("Please enter a valid amount.", True)
            Return False
        End If

        expenseDate = dtpExpenseDate.Value.Date
        Return True
    End Function

    ' ── add ───────────────────────────────────────────────────────────────
    Private Sub btnAdd_Click(sender As Object, e As EventArgs) Handles btnAdd.Click
        Dim categoryID As Integer, amount As Decimal, description As String = "", expenseDate As DateTime
        If Not TryGetValidatedInput(categoryID, description, amount, expenseDate) Then Return

        Dim conn = DBConnection.GetConnection()
        conn.Open()
        Dim cmd As New MySqlCommand(
            "INSERT INTO Expenses (CategoryID, Description, Amount, ExpenseDate, IsAutoGenerated)
             VALUES (@cat, @desc, @amount, @date, 0)", conn)
        cmd.Parameters.AddWithValue("@cat", categoryID)
        cmd.Parameters.AddWithValue("@desc", description)
        cmd.Parameters.AddWithValue("@amount", amount)
        cmd.Parameters.AddWithValue("@date", expenseDate.ToString("yyyy-MM-dd"))
        cmd.ExecuteNonQuery()
        conn.Close()

        ShowMessage("Expense added successfully.")
        LoadExpenses()
        ClearEditPanel()
    End Sub

    ' ── update ────────────────────────────────────────────────────────────
    Private Sub btnUpdate_Click(sender As Object, e As EventArgs) Handles btnUpdate.Click
        If selectedExpenseID = 0 Then
            ShowMessage("Please select an expense to update.", True)
            Return
        End If

        Dim categoryID As Integer, amount As Decimal, description As String = "", expenseDate As DateTime
        If Not TryGetValidatedInput(categoryID, description, amount, expenseDate) Then Return

        Dim conn = DBConnection.GetConnection()
        conn.Open()
        Dim cmd As New MySqlCommand(
        "UPDATE Expenses SET CategoryID = @cat, Description = @desc, Amount = @amount, ExpenseDate = @date
         WHERE ExpenseID = @eid AND IsAutoGenerated = 0", conn)
        cmd.Parameters.AddWithValue("@cat", categoryID)
        cmd.Parameters.AddWithValue("@desc", description)
        cmd.Parameters.AddWithValue("@amount", amount)
        cmd.Parameters.AddWithValue("@date", expenseDate.ToString("yyyy-MM-dd"))
        cmd.Parameters.AddWithValue("@eid", selectedExpenseID)
        Dim rowsAffected = cmd.ExecuteNonQuery()
        conn.Close()

        If rowsAffected = 0 Then
            ShowMessage("This expense could not be updated (it may be auto-generated or no longer exists).", True)
        Else
            ShowMessage("Expense updated successfully.")
        End If
        LoadExpenses()
        ClearEditPanel()
    End Sub

    ' ── delete ────────────────────────────────────────────────────────────
    Private Sub btnDelete_Click(sender As Object, e As EventArgs) Handles btnDelete.Click
        If selectedExpenseID = 0 Then
            ShowMessage("Please select an expense to delete.", True)
            Return
        End If
        If pendingDeleteID <> selectedExpenseID Then
            pendingDeleteID = selectedExpenseID
            ShowMessage("Click Delete again to confirm.", True)
            Return
        End If
        pendingDeleteID = 0

        Dim conn = DBConnection.GetConnection()
        conn.Open()
        Dim cmd As New MySqlCommand("DELETE FROM Expenses WHERE ExpenseID = @eid AND IsAutoGenerated = 0", conn)
        cmd.Parameters.AddWithValue("@eid", selectedExpenseID)
        Dim rowsAffected = cmd.ExecuteNonQuery()
        conn.Close()

        If rowsAffected = 0 Then
            ShowMessage("This expense could not be deleted (it may be auto-generated or no longer exists).", True)
        Else
            ShowMessage("Deleted successfully.")
        End If

        LoadExpenses()
        ClearEditPanel()
    End Sub
    ' ── clear ─────────────────────────────────────────────────────────────
    Private Sub btnClear_Click(sender As Object, e As EventArgs) Handles btnClear.Click
        ClearEditPanel()
        ShowMessage("")
    End Sub

    Private Sub ClearEditPanel()
        selectedExpenseID = 0
        pendingDeleteID = 0
        cboCategory.SelectedIndex = -1
        cboCategory.Enabled = True
        txtDescription.Clear()
        txtDescription.Enabled = True
        txtAmount.Clear()
        txtAmount.Enabled = True
        dtpExpenseDate.Value = DateTime.Today
        dtpExpenseDate.Enabled = True
        btnUpdate.Enabled = True
        btnDelete.Enabled = True
    End Sub

    ' ── filter ────────────────────────────────────────────────────────────
    Private Sub btnFilter_Click(sender As Object, e As EventArgs) Handles btnFilter.Click
        Dim catID = Convert.ToInt32(cboFilterCategory.SelectedValue)
        LoadExpenses(
        categoryID:=If(catID = 0, 0, catID),
        dateFrom:=dtpFrom.Value.Date,
        dateTo:=dtpTo.Value.Date,
        searchTerm:=txtSearchDescription.Text
    )
    End Sub

    Private Sub txtSearchDescription_TextChanged(sender As Object, e As EventArgs) Handles txtSearchDescription.TextChanged
        Dim catID = If(cboFilterCategory.SelectedValue IsNot Nothing, Convert.ToInt32(cboFilterCategory.SelectedValue), 0)
        LoadExpenses(
        categoryID:=catID,
        dateFrom:=dtpFrom.Value.Date,
        dateTo:=dtpTo.Value.Date,
        searchTerm:=txtSearchDescription.Text)
    End Sub

    Private Sub btnClearSearch_Click(sender As Object, e As EventArgs) Handles btnClearSearch.Click
        txtSearchDescription.Clear()
        ' TextChanged fires automatically and reloads with no search filter
    End Sub


    Private Sub btnClearFilter_Click(sender As Object, e As EventArgs) Handles btnClearFilter.Click
        cboFilterCategory.SelectedIndex = 0
        dtpFrom.Value = DateTime.Today.AddMonths(-1)
        dtpTo.Value = DateTime.Today
        txtSearchDescription.Clear()
        LoadExpenses()
    End Sub

    Private Sub btnBack_Click(sender As Object, e As EventArgs) Handles btnBack.Click
        frmAdminDashboard.Show()
        Me.Close()
    End Sub

    Private Sub cboCategory_SelectedIndexChanged(sender As Object, e As EventArgs) Handles cboCategory.SelectedIndexChanged

    End Sub

    Private Sub dgvExpenses_CellContentClick(sender As Object, e As DataGridViewCellEventArgs) Handles dgvExpenses.CellContentClick

    End Sub
End Class